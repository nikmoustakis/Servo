<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="FB_Servo" Id="{a9b0bc75-5c35-4985-b9cb-a8697ca3dc67}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Servo IMPLEMENTS ITF_Servo
VAR_INPUT
END_VAR
VAR_OUTPUT
END_VAR
VAR
	Power         	   : MC_POWER;
	MoveAbsolute  	   : MC_MoveAbsolute;
	Move_Relative 	   : MC_MoveRelative;
	MoveVelocity  	   : MC_MoveVelocity;
	mc_MoveGearInDyn   : MC_GearInDyn;
	mc_GearOut         : MC_GearOut;
	Reset         	   : MC_Reset;
	ReadStatus    	   : MC_READSTATUS;
	Stop          	   : MC_STOP;
	Status             : ST_AxisStatus;

	Axis               : Axis_REF;
	
	//Slave          : REFERENCE TO AXIS_REF;
	Interlock          : ST_ServoInterlocks;
	ServoConfiguration : ST_ServoConfiguration;
	
	Position           : LREAL;
	Velocity           : LREAL;
	Acceleration       : LREAL;
	Deceleration       : LREAL;
	Jerk               : LREAL;
	
    GearRatio          : LREAL;
   
	
	Stop_Decel         : LREAL;
	Stop_Jerk          : LREAL;
	
	ServoAxisMove      : ST_ServoAxisMove;
	
	//Commands
	Reset_Command      : BOOL;
	Move_Abs_Command   : BOOL;
	Move_Rel_Command   : BOOL;
	Move_Vel_Command   : BOOL;
	GearIn_Dyn_Command : BOOL;
	GearOut_Command    : BOOL;
	Stop_Command       : BOOL;
	Init               : BOOL := TRUE;
	
	
	fb_WriteJson       : FB_WriteJsonValues;
	fb_ReadJson        : FB_ReadJsonValues;
	fb_WriteToFile     : FB_WriteToFile;

	
END_VAR

VAR
	ReadServoJsonState : (IDLE, READ_NC, WRITE_NC, WAIT, ERROR);
	PosBiasState : (IDLE, READ_NC, CALCULATE_NEW, WRITE_NC, WAIT, ERROR);
	SetPosBias   : BOOL;
	fbReadNC     : ADSREAD := ( NETID := '', PORT := 501, TMOUT := DEFAULT_ADS_TIMEOUT );
	fbWriteNC    : ADSWRITE := ( NETID := '', PORT := 501, TMOUT := DEFAULT_ADS_TIMEOUT );
	CurrentNCPos        : LREAL;
	NewNCPos            : LREAL;
	DesiredNCPos        : LREAL;
	
	JsonNCPos           : LREAL;
	
	sFilePathName : T_MAXSTRING := 'C:\MyJsonFile.json';
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[_M_AxisStatus();
_M_AxisPower();

_M_MoveAbsolute();
_M_MoveRelative();
_M_MoveVelocity();





_M_AxisStop();


_M_Reset();


_M_ReadServoJson();
_M_ReadWritePositionBias();


Init := FALSE;



]]></ST>
    </Implementation>
