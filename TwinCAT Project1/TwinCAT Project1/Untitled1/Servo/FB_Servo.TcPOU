    <Method Name="_M_AxisPower" Id="{4c330321-e3d3-4957-bc2e-0261fcc2edf7}" FolderPath="private\Axis Commands\">
      <Declaration><![CDATA[METHOD PRIVATE _M_AxisPower : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Power(Axis := Axis, 
		Enable := Interlock.SafetyOk, 
		Enable_Positive := Interlock.Move_Positive, 
		Enable_Negative := Interlock.Move_Negative,
		Override := 100);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="_M_AxisStatus" Id="{5137a974-7a96-4899-a668-672a484c6090}" FolderPath="private\Axis Commands\">
      <Declaration><![CDATA[METHOD PRIVATE _M_AxisStatus : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[ReadStatus(Axis := Axis, Enable := TRUE);

Status := ReadStatus.Status;]]></ST>
      </Implementation>
    </Method>
    <Method Name="_M_AxisStop" Id="{d13ef632-250d-463c-8ea5-b48f2156dd0a}" FolderPath="private\Axis Commands\">
      <Declaration><![CDATA[METHOD PRIVATE _M_AxisStop : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
Stop(Axis := Axis, Execute := Stop_Command, Deceleration := Stop_Decel, Jerk := Stop_Jerk);

IF Stop.Done THEN 
	
	Stop_Command := FALSE;
END_IF


]]></ST>
      </Implementation>
    </Method>
