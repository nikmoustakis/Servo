    <Method Name="_M_ReadServoJson" Id="{d16e2cba-8fa2-4d23-8b1b-1ba92e2551cd}" FolderPath="private\NC Params\">
      <Declaration><![CDATA[METHOD PRIVATE _M_ReadServoJson : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE ReadServoJsonState OF
	IDLE: 
		IF Init THEN 
			ReadServoJsonState := READ_NC;
		END_IF
	
	READ_NC:
		sFilePathName := 'C:\MyJsonFile\';
		sFilePathName := CONCAT(sFilePathName,ServoConfiguration.Name);
		sFilePathName := CONCAT(sFilePathName,'.json');
		fb_ReadJson(sFilePathName := sFilePathName);
		fb_ReadJson.M_LoadJsonFile();
		
		IF fb_ReadJson.Done THEN 
			JsonNCPos    := fb_ReadJson.fPositionBias;
			ReadServoJsonState := WRITE_NC;
		END_IF
		
		
	WRITE_NC:
		fbWriteNC( IDXGRP := 20480 + Axis.NcToPlc.AxisId, IDXOFFS := 16#00000007, LEN := 8, SRCADDR  := ADR(JsonNCPos), WRITE := TRUE );

		ReadServoJsonState := WAIT;
		
	WAIT:
		fbWriteNC(WRITE := FALSE);
		
		IF NOT fbWriteNC.BUSY THEN
			IF NOT fbWriteNC.ERR THEN 
				
				ReadServoJsonState := IDLE;
			END_IF
		END_IF	
		IF fbWriteNC.ERR THEN 
			ReadServoJsonState := ERROR;
		END_IF
	
	ERROR:
//		fbWriteNC.ERR := FALSE;
//		fbReadNC.ERR := FALSE;
		
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="_M_ReadWritePositionBias" Id="{5f590d50-7e02-4b7a-9864-8d9378f50ec5}" FolderPath="private\NC Params\">
      <Declaration><![CDATA[METHOD PRIVATE _M_ReadWritePositionBias : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE PosBiasState OF
	IDLE: 
		IF SetPosBias OR Init THEN 
			PosBiasState := READ_NC;
			SetPosBias := FALSE;
		END_IF
	
	READ_NC:
		fbReadNC( IDXGRP := 20480 + Axis.NcToPlc.AxisId, IDXOFFS := 16#00000007, LEN := 8, DESTADDR := ADR(CurrentNCPos), READ := TRUE );

		PosBiasState := CALCULATE_NEW;
		
	CALCULATE_NEW:
		fbReadNC(READ := FALSE);
		
		IF NOT fbReadNC.BUSY THEN
			IF NOT fbReadNC.ERR THEN 
				NewNCPos := DesiredNCPos - Axis.NcToPlc.ActPos;
				PosBiasState := WRITE_NC;
			END_IF
		END_IF	
		IF fbReadNC.ERR THEN 
			PosBiasState := ERROR;
		END_IF
		
	WRITE_NC:
		fbWriteNC( IDXGRP := 20480 + Axis.NcToPlc.AxisId, IDXOFFS := 16#00000007, LEN := 8, SRCADDR  := ADR(NewNCPos), WRITE := TRUE );

		PosBiasState := WAIT;
		
	WAIT:
		fbWriteNC(WRITE := FALSE);
		
		IF NOT fbWriteNC.BUSY THEN
			IF NOT fbWriteNC.ERR THEN 
				
				PosBiasState := IDLE;
			END_IF
		END_IF	
		IF fbReadNC.ERR THEN 
			PosBiasState := ERROR;
		END_IF
	
	ERROR:
//		fbWriteNC.ERR := FALSE;
//		fbReadNC.ERR := FALSE;
		
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="_M_Reset" Id="{f4c6b72c-1516-450c-baf2-151d10c2a097}" FolderPath="private\Axis Commands\">
      <Declaration><![CDATA[METHOD PRIVATE _M_Reset : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[

IF Reset.Done THEN 
	
	Reset_Command := FALSE;
END_IF

Reset(Axis := Axis, Execute := Reset_Command);

IF PosBiasState = ERROR THEN
	PosBiasState := IDLE;

END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_GearInDyn" Id="{182f26a4-64ea-4bc0-9a99-5e651eb14d69}" FolderPath="Axis Commands\">
      <Declaration><![CDATA[METHOD M_GearInDyn : BOOL
VAR_INPUT
    GearRatio : LREAL;
    Acceleration : LREAL;
    Deceleration : LREAL;
    Jerk     : LREAL;
	
	Slave : REFERENCE TO AXIS_REF;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[mc_GearOut(Slave := Slave,
			Execute := FALSE);

mc_MoveGearInDyn(Master := Axis,
					Slave := Slave,
					Enable := TRUE,
					GearRatio := GearRatio,
					Acceleration := Acceleration,
					Deceleration := Deceleration,
					Jerk := Jerk);
					
					







					]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_GearOut" Id="{dd7c4642-3c10-4b17-9cb9-913b94304714}" FolderPath="Axis Commands\">
      <Declaration><![CDATA[METHOD M_GearOut : BOOL
VAR_INPUT
	Slave : REFERENCE TO AXIS_REF;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[mc_MoveGearInDyn(Master := Axis,
					Slave := Slave,
					Enable := FALSE);

mc_GearOut(Slave := Slave,
			Execute := TRUE);
					]]></ST>
      </Implementation>
    </Method>
