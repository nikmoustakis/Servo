    <Method Name="M_ServoInTargetPos" Id="{975e008a-d4ce-442f-9c13-57b0a17c9c1b}" FolderPath="Axis Commands\">
      <Declaration><![CDATA[METHOD PUBLIC M_ServoInTargetPos : BOOL
VAR_INPUT
	Position  : LREAL;
	Precision : LREAL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[

M_ServoInTargetPos := abs(aXIS.NcToPlc.ActPos - Position) <= Precision;]]></ST>
      </Implementation>
    </Method>
