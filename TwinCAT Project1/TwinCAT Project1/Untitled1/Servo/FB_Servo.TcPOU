    <Method Name="_M_MoveAbsolute" Id="{255f90ca-2a73-42d8-a8c4-38d18a1625bc}" FolderPath="private\Axis Commands\">
      <Declaration><![CDATA[METHOD PRIVATE _M_MoveAbsolute


]]></Declaration>
      <Implementation>
        <ST><![CDATA[

MoveAbsolute(Axis := Axis,
	Execute := Move_abs_CommaND,
	Position := Position, 
	Velocity := Velocity, 
	Acceleration := Acceleration,
	Deceleration := Deceleration,
	jerk:= Jerk);
	

Move_abs_CommaND := FALSE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="_M_MoveRelative" Id="{af615df7-338b-44c1-af2d-18935f295b52}" FolderPath="private\Axis Commands\">
